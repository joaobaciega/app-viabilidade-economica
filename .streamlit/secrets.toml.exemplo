# MODELO. Copie para `.streamlit/secrets.toml` e preencha — NUNCA versione o
# arquivo preenchido: `.streamlit/secrets.toml` esta no .gitignore, e este
# `.exemplo` existe justamente para o de verdade nunca precisar entrar no
# repositorio para alguem saber quais chaves ele tem.
#
# NO DEPLOY nao existe arquivo: as mesmas chaves vao coladas no painel
# "Secrets" do Streamlit Community Cloud (docs/DEPLOY.md).
#
# SEM ESTA SECAO O APP CONTINUA INTEIRO. O botao "Enviar por e-mail" aparece
# CINZA E DESABILITADO, com uma linha abaixo dizendo que o envio nao esta
# configurado, e o botao de BAIXAR o PDF — que e o caminho que nao depende de
# credencial nenhuma — continua entregando o documento. Nada aqui e requisito
# para a Tela 1 funcionar (D30).
#
# EM USO desde 01/09/2026: Google Workspace, conta joao@suicatech.com.br.

[email]
# Servidor de saida. Gmail: smtp.gmail.com · Microsoft 365: smtp.office365.com
host = "smtp.exemplo.com.br"

# 587 = STARTTLS (o normal). 465 = SMTPS, TLS desde a conexao. O app escolhe o
# modo pela porta; nao ha chave separada para isso.
porta = 587

usuario = "simulador@exemplo.com.br"

# GMAIL E MICROSOFT 365 NAO ACEITAM A SENHA DA CONTA aqui. Gere uma SENHA DE
# APLICATIVO na conta (exige verificacao em duas etapas ligada) e cole ela.
senha = "senha-de-aplicativo"

# O que o destinatario ve no campo "De". Opcional: sem esta chave, o app usa o
# proprio `usuario`.
#
# O ENDERECO AQUI TEM DE SER O MESMO DE `usuario`. O Gmail reescreve o "De" para
# a conta autenticada quando eles diferem: o e-mail chega, mas vindo de outro
# endereco, e nada avisa. O nome antes do <...> e livre.
remetente = "Suicatech · Intrace AG <simulador@exemplo.com.br>"
